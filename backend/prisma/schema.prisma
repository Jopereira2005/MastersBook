datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// ==========================================
// ENUMS
// ==========================================

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum MessageType {
  STORY   // Chat de Jogo (In-Character/Narrativa)
  OOC     // Chat de Players (Sidebar/Out-of-Character)
  LOG     // Registro de Sistema (Dano, Clima, etc)
  DICE    // Resultados de Dados
}

// ==========================================
// MODELOS DE USUÁRIO E SOCIAL
// ==========================================

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")

  // Relacionamentos
  characters  Character[]
  ownedTables Table[]       @relation("GM")
  memberships TablePlayer[]
  friendsSent Friendship[]  @relation("User1")
  friendsRecv Friendship[]  @relation("User2")
  messages    Message[]     // Relacionamento com Chat
}

model Friendship {
  id        String           @id @default(uuid())
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")

  user1Id String @map("user_id_1")
  user1   User   @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)

  user2Id String @map("user_id_2")
  user2   User   @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
}

// ==========================================
// MODELOS DE RPG E REGRAS
// ==========================================

model System {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relacionamentos
  characters Character[]
  tables     Table[]
}

model Character {
  id         String   @id @default(uuid())
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  race       String
  class      String
  level      Int      @default(1)
  attributes Json     // Dados base da ficha
  bio        String?
  avatarUrl  String?  @map("avatar_url")
  createdAt  DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  systemId String @map("system_id")
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  tablePlayers TablePlayer[]
  messages     Message[]     // Relacionamento com Chat (Ficha falando)
}

// ==========================================
// MODELOS DE MESA E SESSÃO (VTT)
// ==========================================

model Table {
  id          String  @id @default(uuid())
  name        String
  description String?
  inviteCode  String  @unique @map("invite_code")

  gmId String @map("gm_id")
  gm   User   @relation("GM", fields: [gmId], references: [id], onDelete: Cascade)

  systemId String @map("system_id")
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  players  TablePlayer[]
  state    TableState?
  messages Message[]     // Histórico de mensagens da mesa
}

model TablePlayer {
  id                  String  @id @default(uuid())
  currentAttributes   Json?   @map("current_attributes")
  temporaryAttributes Json?   @map("temporary_attributes")
  conditions          Json?
  privateNotes        String? @map("private_notes")

  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableId     String    @map("table_id")
  table       Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model TableState {
  id              String  @id @default(uuid())
  currentLocation String? @map("current_location")
  inGameDate      String? @map("in_game_date")
  weather         String?
  activeScene     String  @default("EXPLORATION") @map("active_scene")
  publicNotes     String? @map("public_notes")

  isCombatActive  Boolean  @default(false) @map("is_combat_active")
  turnOrder       String[] @map("turn_order")
  currentTurn     Int      @default(0)     @map("current_turn")

  tableId String @unique @map("table_id")
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

// ==========================================
// SISTEMA DE CHAT E LOGS
// ==========================================

model Message {
  id          String      @id @default(uuid())
  type        MessageType @default(STORY)
  content     String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String?     @map("character_id")
  character   Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)

  tableId     String      @map("table_id")
  table       Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
}


