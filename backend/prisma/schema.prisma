datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Definição do ENUM para status de amizade
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// Tabela de Usuários
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")

  // Relacionamentos
  characters  Character[]
  ownedTables Table[]       @relation("GM")
  memberships TablePlayer[]
  friendsSent Friendship[]  @relation("User1")
  friendsRecv Friendship[]  @relation("User2")
}

// Tabela de Sistemas de RPG
model System {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relacionamentos
  characters Character[]
  tables     Table[]
}

// Tabela de Personagens (Fichas)
model Character {
  id         String   @id @default(uuid())
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  race       String
  class      String
  level      Int      @default(1)
  attributes Json     // Dados flexíveis como HP máximo, Atributos base
  bio        String?
  avatarUrl  String?  @map("avatar_url")
  createdAt  DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  systemId String @map("system_id")
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  tablePlayers TablePlayer[]
}

// Tabela de Mesas (Campanhas)
model Table {
  id          String  @id @default(uuid())
  name        String
  description String?
  inviteCode  String  @unique @map("invite_code")

  gmId String @map("gm_id")
  gm   User   @relation("GM", fields: [gmId], references: [id], onDelete: Cascade)

  systemId String @map("system_id")
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  players TablePlayer[]
  state       TableState?
}

// Tabela Intermediária (Jogadores nas Mesas com Status de Sessão)
model TablePlayer {
  id                  String  @id @default(uuid())

  // O Status Temporário "Durante a Mesa" (Agnóstico de Sistema)
  currentAttributes   Json?   @map("current_attributes")
  temporaryAttributes Json?   @map("temporary_attributes")
  conditions          Json?
  privateNotes        String? @map("private_notes")

  // Relacionamentos
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tableId     String    @map("table_id")
  table       Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)

  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// Tabela de Estado Global da Sessão (O Mundo)
model TableState {
  id              String  @id @default(uuid())
  currentLocation String? @map("current_location")
  inGameDate      String? @map("in_game_date")
  weather         String?
  activeScene     String  @default("EXPLORATION") @map("active_scene") // Pode ser EXPLORATION, COMBAT, SOCIAL...
  initiativeOrder Json?   @map("initiative_order") // Guarda a ordem dos turnos: [{ characterId: "...", roll: 18 }]
  publicNotes     String? @map("public_notes")     // Quadro de avisos do GM para todos

  // Relação 1-para-1 com a Mesa
  tableId         String  @unique @map("table_id") // O @unique é o que garante que é 1-para-1
  table           Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

// Tabela de Amizades
model Friendship {
  id        String           @id @default(uuid())
  status    FriendshipStatus @default(PENDING) // Uso do Enum
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")

  user1Id String @map("user_id_1")
  user1   User   @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)

  user2Id String @map("user_id_2")
  user2   User   @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
}
